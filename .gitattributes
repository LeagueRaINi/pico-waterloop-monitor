# Normalise to LF everywhere. The Rust bridge embeds firmware/ byte for byte
# and sends it to the device, so a checkout must not vary by platform.
* text=auto eol=lf

# Images are binary - never line-ending normalise them.
*.jpg -text
*.jpeg -text
*.png -text

# Fonts are generated tables; keep diffs out of the way.
firmware/lib/st7789/romfonts/*.py linguist-generated=true
firmware/lib/st7789/** linguist-vendored=true
